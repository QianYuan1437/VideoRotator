    <string name="privacy_intro">VideoRotator respects your privacy:</string>
    <string name="privacy_1_title">1. On-device processing</string>
    <string name="privacy_1_body">All rotation happens on your device. Neither the original videos nor the results are uploaded anywhere.</string>
    <string name="privacy_2_title">2. No data collection</string>
    <string name="privacy_2_body">The app contains no analytics or tracking SDKs and uploads no usage data.</string>
    <string name="privacy_3_title">3. File access</string>
    <string name="privacy_3_body">Videos are read only through the Android media library or folders you choose. Android 13+ uses READ_MEDIA_VIDEO; earlier versions use READ_EXTERNAL_STORAGE. With the system folder picker (SAF), only folders you grant can be accessed.</string>
    <string name="privacy_4_title">4. Output location</string>
    <string name="privacy_4_body">Converted videos are saved where you choose in Convert settings (Movies / DCIM / Download / app private folder / a custom folder).</string>
    <string name="privacy_5_title">5. Open source</string>
    <string name="privacy_5_body">The app is open source; the full code is on GitHub for review.</string>
